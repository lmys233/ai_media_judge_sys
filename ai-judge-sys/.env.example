# AI Judge System - 开发环境变量（安全，可上传至 Git）
# 复制此文件为 .env.dev 并填入实际值

# DashScope (阿里云通义千问) API 配置
# 获取地址: https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=sk-your-api-key-here

# LLM 配置（如使用 OpenAI 或 Anthropic 可在此设置）
# LLM_API_KEY=sk-your-openai-key
# JUDGE_API_KEY=sk-your-judge-key
# DESENSITIZE_LLM_API_KEY=sk-your-desensitize-key
